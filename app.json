{
  "expo": {
    "name": "Caminha",
    "slug": "caminha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "O Caminha usa o pedômetro para contar os passos da sua caminhada.",
        "NSLocationWhenInUseUsageDescription": "O GPS é opcional e só serve para estimar a distância da rota."
      }
    },
    "android": {
      "package": "com.thales971.caminha",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-sensors",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GPS é opcional e só serve para estimar a distância da rota."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "045810bf-6e32-4e40-85f5-d785237e66a1"
      }
    },
    "owner": "thales098776"
  }
}
